{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlens.local/ai-ops/task.schema.json",
  "title": "MarketLens Grok Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mode", "baseCommit", "objective", "allowedPaths", "forbiddenPaths", "verification", "maxTurns"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "mode": {
      "enum": ["review", "implement"]
    },
    "baseCommit": {
      "type": "string",
      "minLength": 7
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "allowedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbiddenPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verification": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "resumeSessionId": {
      "type": "string",
      "minLength": 8
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 30000,
      "maximum": 3600000,
      "default": 1200000
    }
  }
}

