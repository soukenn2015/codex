{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlens.local/ai-ops/task.schema.json",
  "title": "MarketLens Grok Build Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mode", "baseCommit", "objective", "allowedPaths", "forbiddenPaths", "verification", "maxTurns"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "mode": {
      "enum": ["review", "implement"]
    },
    "baseCommit": {
      "type": "string",
      "minLength": 7
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "current_location": {
      "type": "string",
      "minLength": 3
    },
    "overall_progress": {
      "type": "string",
      "pattern": "^(現在推定 |現在 )?(100|[0-9]{1,2})%$"
    },
    "scope_progress": {
      "type": "string",
      "minLength": 3
    },
    "current_purpose": {
      "type": "string",
      "minLength": 3
    },
    "recommended_model": {
      "type": "string",
      "minLength": 3
    },
    "token_policy": {
      "enum": ["軽め", "標準", "慎重"]
    },
    "read_targets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "do_not_read": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "risk_level": {
      "enum": ["低", "中", "高"]
    },
    "marketlens_body_change": {
      "type": "boolean"
    },
    "allowedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbiddenPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbiddenKeywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verification": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "resumeSessionId": {
      "type": "string",
      "minLength": 8
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 30000,
      "maximum": 3600000,
      "default": 1200000
    }
  }
}
